{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ],
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    }
  },
  "include": [
    "frontend",
    "webview",
    ".millennium/**/*.d.ts"
  ]
}